// Prisma schema for BarberOS - Local SQLite, scalable to PostgreSQL for SaaS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Tenant: cada barbearia isola seus dados operacionais pelo barbeariaId.
model Barbearia {
  barberPermissions Json @default("{}")
  id           String         @id @default(cuid())
  name         String
  subdomain    String         @unique // ex.: "america" em america.navalha.app
  customDomain String?        @unique // domínio próprio, normalizado (ex.: "americabarbearia.tech")
  timezone     String         @default("America/Porto_Velho") // IANA; usado para agenda e lembretes
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  users        User[]
  clients      Client[]
  services     Service[]
  appointments Appointment[]
  transactions Transaction[]
  categories   Category[]
  alerts       FinanceAlert[]
  goals        Goal[]
  products     Product[]
  packages     Package[]
  clientPackages ClientPackage[]
}

model Client {
  id           String        @id @default(cuid())
  barbeariaId  String
  name         String
  phone        String
  email        String?
  notes        String?
  isActive     Boolean       @default(true) // <-- Campo para soft delete
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id])
  appointments Appointment[]
  clientPackages ClientPackage[]

  // Mesmo telefone pode ser cliente de barbearias diferentes
  @@unique([barbeariaId, phone])
}

model Service {
  id                  String               @id @default(cuid())
  barbeariaId         String
  name                String
  description         String?
  price               Float
  durationMins        Int                  @default(30)
  imageUrl            String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  barbearia           Barbearia            @relation(fields: [barbeariaId], references: [id])
  appointments        Appointment[]
  appointmentServices AppointmentService[]

  @@index([barbeariaId])
}

model Appointment {
  id                  String               @id @default(cuid())
  barbeariaId         String
  clientId            String
  serviceId           String
  date                DateTime
  status              AppointmentStatus    @default(PENDING)
  notes               String?
  barberId            String? // ID do barbeiro que realizará o serviço
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  reminderSent        Boolean              @default(false)
  // Exclusão lógica ("excluído por engano"): somente ADMIN, com motivo obrigatório
  deletedAt           DateTime?
  deletedById         String?
  deletionReason      String?
  barbearia           Barbearia            @relation(fields: [barbeariaId], references: [id])
  client              Client               @relation(fields: [clientId], references: [id])
  service             Service              @relation(fields: [serviceId], references: [id])
  barber              User?                @relation("AppointmentBarber", fields: [barberId], references: [id]) // Relacionamento com o barbeiro
  deletedBy           User?                @relation("AppointmentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  commissionPercent   Float?
  commissionAmount    Float?
  commissionPaid      Boolean              @default(false)
  clientPackageId     String?
  clientPackage       ClientPackage?       @relation(fields: [clientPackageId], references: [id])
  transaction         Transaction?
  appointmentServices AppointmentService[]

  @@index([barbeariaId, date])
}

// Herda a barbearia pelo agendamento (sem barbeariaId próprio)
model AppointmentService {
  appointmentId String
  serviceId     String
  price         Float
  durationMins  Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@index([serviceId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

model Transaction {
  id            String          @id @default(cuid())
  barbeariaId   String
  type          TransactionType
  amount        Float
  description   String
  category      String?
  categoryId    String?
  appointmentId String?         @unique
  date          DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  // Estorno auditado: a transação de estorno aponta para a original (no máximo um estorno por transação)
  reversalOfId  String?         @unique
  createdById   String?
  reason        String?
  barbearia     Barbearia       @relation(fields: [barbeariaId], references: [id])
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  categoryRef   Category?       @relation(fields: [categoryId], references: [id])
  reversalOf    Transaction?    @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal      Transaction?    @relation("TransactionReversal")
  createdBy     User?           @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([barbeariaId, date])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id           String        @id @default(cuid())
  barbeariaId  String
  name         String
  icon         String        @default("CircleDollarSign")
  color        String        @default("#6b7280")
  type         CategoryType  @default(BOTH)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id])
  transactions Transaction[]

  @@unique([barbeariaId, name])
  @@index([barbeariaId])
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}

model FinanceAlert {
  id          String           @id @default(cuid())
  barbeariaId String
  type        FinanceAlertType
  message     String
  severity    AlertSeverity    @default(INFO)
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  barbearia   Barbearia        @relation(fields: [barbeariaId], references: [id])

  @@index([barbeariaId])
}

enum FinanceAlertType {
  OVER_LIMIT
  NEGATIVE_BALANCE
  HIGH_SPENDING
  MONTH_COMPARISON
  GOAL_REACHED
}

enum AlertSeverity {
  INFO
  WARNING
  DANGER
}

model Goal {
  id           String    @id @default(cuid())
  barbeariaId  String
  title        String
  type         GoalType
  targetAmount Float
  period       String // "daily" | "weekly" | "monthly"
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  barbearia    Barbearia @relation(fields: [barbeariaId], references: [id])

  @@index([barbeariaId])
}

enum GoalType {
  REVENUE
  CLIENTS
  APPOINTMENTS
}

enum Role {
  ADMIN
  BARBER
}

model User {
  permissionOverrides Json @default("{}")
  id                  String        @id @default(cuid())
  barbeariaId         String
  name                String
  email               String        @unique // Único em todo o sistema (login global)
  password            String
  phone               String?
  avatarUrl           String?
  role                Role          @default(ADMIN) // Papel do usuário (Admin ou Barbeiro)
  active              Boolean       @default(true) // Desativado: sem login, sem sessão e sem agendamentos novos
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  barbearia           Barbearia     @relation(fields: [barbeariaId], references: [id])
  appointments        Appointment[] @relation("AppointmentBarber") // Agendamentos vinculados a este barbeiro
  deletedAppointments Appointment[] @relation("AppointmentDeletedBy")
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  commissionPercent   Float         @default(50.0) // Comissão padrão em % (20 a 75)
  packages            Package[]     @relation("BarberPackages")
  clientPackages      ClientPackage[] @relation("BarberClientPackages")

  @@index([barbeariaId])
}

model Product {
  id          String    @id @default(cuid())
  barbeariaId String
  name        String
  description String?
  price       Float
  stock       Int       @default(0) // Controle de estoque
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id])

  @@index([barbeariaId])
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELED
}

model Package {
  id           String          @id @default(cuid())
  barbeariaId  String
  name         String
  description  String?
  price        Float
  totalCuts    Int             @default(4)
  validityDays Int             @default(30)
  barberId     String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  barbearia      Barbearia       @relation(fields: [barbeariaId], references: [id])
  barber         User?           @relation("BarberPackages", fields: [barberId], references: [id])
  clientPackages ClientPackage[]

  @@index([barbeariaId])
  @@index([barberId])
}

model ClientPackage {
  id           String        @id @default(cuid())
  barbeariaId  String
  clientId     String
  packageId    String
  barberId     String?
  totalCuts    Int
  usedCuts     Int           @default(0)
  startDate    DateTime      @default(now())
  expiresAt    DateTime
  status       PackageStatus @default(ACTIVE)
  paidToAdmin  Boolean       @default(false)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  package      Package       @relation(fields: [packageId], references: [id])
  barber       User?         @relation("BarberClientPackages", fields: [barberId], references: [id])
  appointments Appointment[]

  @@index([barbeariaId])
  @@index([clientId])
  @@index([packageId])
  @@index([barberId])
  @@index([status])
}
