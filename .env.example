# BarberOS - Variáveis de Ambiente
# Copie este arquivo para .env. No desenvolvimento o banco é SEMPRE o local (docker compose up db).
# A URL de produção nunca fica no .env da máquina de desenvolvimento: seed, db:push, db:migrate, db:reset,
# fixtures e testes recusam rodar fora de localhost (scripts/local-db-guard.ts).

# Banco local do docker-compose.yml (porta 5440)
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/barberos"

# Conexão direta (usada pelas migrations). No banco local é a mesma.
DIRECT_URL="postgresql://postgres:postgres@localhost:5440/barberos"

# Porta do servidor (opcional, padrão: 3000)
# PORT=3000

# Segredo de assinatura do JWT de sessão (obrigatório, mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"

# Evolution API (WhatsApp). Obrigatórias: sem elas o envio falha (não há valor padrão).
# EVO_API_KEY também é lida pelo docker-compose.yml (AUTHENTICATION_API_KEY da Evolution).
NEXT_PUBLIC_EVO_URL="http://localhost:8080"
EVO_API_KEY="troque-por-uma-chave-aleatoria"
# Opcional: token da instância enviado em /instance/create.
# EVO_INSTANCE_TOKEN=""

# Telefone do administrador para avisos financeiros (DDI+DDD+número). Sem ele, o aviso é ignorado.
ADMIN_PHONE=""

# Senha do admin criado pelo seed (mínimo 12 caracteres). Admin já existente NÃO tem a senha alterada.
SEED_ADMIN_PASSWORD=""

# Header com o IP real do cliente, definido pelo proxy da VPS (ex.: x-real-ip, cf-connecting-ip, x-forwarded-for).
# Só configure se o proxy SOBRESCREVER esse header; sem proxy, o cliente pode forjá-lo.
# Vazio: limites de login e reserva valem apenas por e-mail e telefone, sem limite por IP.
RATE_LIMIT_IP_HEADER=""

# Pasta das fotos enviadas pelo admin (serviços). Em produção: caminho ABSOLUTO de um volume persistente (ex.: /data/uploads).
# Antes do primeiro uso rode: npm run uploads:init  (cria a pasta e o marcador .navalha-uploads). Sem isso o envio de foto responde 503.
UPLOADS_DIR="./.uploads"

# Multi-tenant (Bloco 3). A barbearia é descoberta pelo Host da requisição:
# 1) <subdominio>.TENANT_ROOT_DOMAIN (ex.: america.navalha.app), ou 2) Barbearia.customDomain (ex.: americabarbearia.tech).
# Host sem barbearia ativa responde 404; nunca cai numa barbearia padrão. O proxy da VPS precisa repassar o Host original.
# Em produção, sem TENANT_ROOT_DOMAIN só domínios próprios funcionam. Fora de produção o padrão é "localhost"
# (abra america.localhost:3000; localhost:3000 sozinho é o domínio raiz e responde 404).
TENANT_ROOT_DOMAIN="navalha.app"
# Somente previews (VERCEL_ENV=preview) e desenvolvimento: força uma barbearia em qualquer host. Ignorado em produção.
# Preview EXIGE banco separado (DATABASE_URL/DIRECT_URL próprios): com o banco de produção, qualquer pessoa com o
# link do preview operaria a barbearia real, e migrations de uma branch em teste alterariam dados de produção.
# TENANT_FIXED_SUBDOMAIN="america"
