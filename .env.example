# BarberOS - Variáveis de Ambiente (Supabase / PostgreSQL)
# Copie este arquivo para .env e cole as URLs fornecidas pelo Supabase

# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgres://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgres://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Porta do servidor (opcional, padrão: 3000)
# PORT=3000

# Segredo de assinatura do JWT de sessão (obrigatório, mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"

# Evolution API (WhatsApp). Obrigatórias: sem elas o envio falha (não há valor padrão).
# EVO_API_KEY também é lida pelo docker-compose.yml (AUTHENTICATION_API_KEY da Evolution).
NEXT_PUBLIC_EVO_URL="http://localhost:8080"
EVO_API_KEY="troque-por-uma-chave-aleatoria"
# Opcional: token da instância enviado em /instance/create.
# EVO_INSTANCE_TOKEN=""

# Telefone do administrador para avisos financeiros (DDI+DDD+número). Sem ele, o aviso é ignorado.
ADMIN_PHONE=""

# Senha do admin criado pelo seed (mínimo 12 caracteres). Admin já existente NÃO tem a senha alterada.
SEED_ADMIN_PASSWORD=""
